# 应用配置
APP_NAME=党政工作智脑
DEBUG=false
HOST=0.0.0.0
PORT=8000

# 数据库配置（Docker网络中使用服务名）
DATABASE_URL=mysql+pymysql://root:root@party-brain-mysql:3306/party_brain?charset=utf8mb4

# Redis配置（如需启用请在docker-compose中添加redis服务）
REDIS_URL=redis://redis:6379/0

# JWT配置（生产环境请更换密钥）
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# LLM配置（阿里云百炼）
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=sk-958b34a3-8d8e-40b7-a7e5-d9b3aff70427
LLM_MODEL=qwen3-8b
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.7

# Embedding配置（阿里云百炼）
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=sk-958b34a3-8d8e-40b7-a7e5-d9b3aff70427
EMBEDDING_MODEL=text-embedding-v3

# Milvus配置（连接总系统 Milvus）
MILVUS_URI=http://192.168.1.100:19530
MILVUS_COLLECTION=party_committee

# 文件存储
UPLOAD_DIR=./uploads
EXPORT_DIR=./exports
