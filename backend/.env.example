# 应用配置
APP_NAME=党政工作智脑
DEBUG=true
HOST=0.0.0.0
PORT=8000

# 数据库配置
# Docker部署时主机名用容器名 party-brain-mysql；本地开发用 localhost
DATABASE_URL=mysql+pymysql://root:root@party-brain-mysql:3306/party_brain?charset=utf8mb4

# Redis配置（当前代码未实际使用，保留供后续扩展）
# Docker部署时用容器名；本地开发用 localhost
REDIS_URL=redis://localhost:6379/0

# JWT配置（生产环境请更换密钥）
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# LLM配置（私有化部署地址）
LLM_BASE_URL=http://localhost:8080/v1
LLM_API_KEY=not-needed
LLM_MODEL=qwen2.5
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.7

# 工具调用模式: "prompt"=Prompt模拟(兼容所有模型), "native"=原生Function Calling
TOOL_CALL_MODE=prompt

# Embedding配置
EMBEDDING_BASE_URL=http://localhost:8080/v1
EMBEDDING_MODEL=bge-large-zh-v1.5

# Milvus配置（可选，不可用时自动降级为SQLite关键词检索）
# Docker部署时用容器名；本地开发用 localhost
MILVUS_HOST=party-brain-milvus
MILVUS_PORT=19530
MILVUS_COLLECTION=policy_knowledge

# 文件存储
UPLOAD_DIR=./uploads
EXPORT_DIR=./exports
