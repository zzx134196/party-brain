# 应用配置
APP_NAME=智慧党建助手
DEBUG=false
HOST=0.0.0.0
PORT=8000

# 数据库配置（SQLite，容器内路径）
DATABASE_URL=sqlite:///./data/party_brain.db

# Redis配置（如需启用请在docker-compose中添加redis服务）
REDIS_URL=redis://redis:6379/0

# JWT配置（总系统统一认证）
SECRET_KEY=7b4c9e2a8f1d6c3b5e9a2f8c7b4d9e6a3f1b8c7d5e9a2f8c7b4d9e6a3f1b8c
ALGORITHM=HS256
JWT_ISSUER=gov-backend
JWT_AUDIENCE=gov-platform
ACCESS_TOKEN_EXPIRE_MINUTES=480

# LLM配置（通过 host.docker.internal 访问宿主机上的本地模型）
LLM_BASE_URL=http://host.docker.internal:8080/v1
LLM_API_KEY=not-needed
LLM_MODEL=qwen2.5
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.7

# 工具调用模式: "workflow"=工作流驱动(最稳定), "prompt"=Prompt模拟, "native"=原生Function Calling
TOOL_CALL_MODE=workflow

# Embedding配置（私有化部署 bge-m3）
EMBEDDING_BASE_URL=http://192.168.1.100:40086/v1
EMBEDDING_API_KEY=gpustack_cd9723bca82e5e9e_a9b7da5f0badf8ad9568d5275624847c
EMBEDDING_MODEL=bge-m3

# ========== 远程部署时取消注释以下配置 ==========
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_API_KEY=sk-your-api-key
# LLM_MODEL=qwen3-8b
# EMBEDDING_BASE_URL=http://127.0.0.1:8080/v1
# EMBEDDING_MODEL=bge-m3
# MILVUS_URI=http://127.0.0.1:19530
# ================================================

# Milvus配置（远程总部向量数据库）
MILVUS_URI=http://192.168.1.100:19530
MILVUS_COLLECTION=party_committee

# 文件存储
UPLOAD_DIR=./uploads
EXPORT_DIR=./exports
